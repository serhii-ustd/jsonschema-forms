{
  "type": "object",
  "required": ["age"],
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20,
          "description": "firstName description"
        },
        "lastName": {
          "type": "string",
          "minLength": 5,
          "maxLength": 15
        },
        "age": {
          "type": "integer",
          "minimum": 18,
          "maximum": 100
        },
        "gender": {
          "type": "string",
          "enum": ["Male", "Female", "Undisclosed"]
        }
      }
    },
    "tags": {
      "type": "array",

      "items": {
        "type": "string"
      }
    },
    "height": {
      "type": "number"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "rating": {
      "type": "integer"
    },
    "committer": {
      "type": "boolean"
    },
    "file": {
      "type": "string",
      "format": "data-url",
      "title": "Document file"
    },
    "address": {
      "title": "Address for Shipping T-Shirt",
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "streetnumber": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      }
    }
  }
}
